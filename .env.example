# Copy this file to .env and fill in real values. .env is gitignored.

# football-data.org — used as X-Auth-Token header
FOOTBALL_DATA_API_TOKEN=

# The Odds API — https://the-odds-api.com
ODDS_API_KEY=

# API-Football, direct api-sports.io dashboard signup (the official method).
# Endpoint: https://v3.football.api-sports.io, header: x-apisports-key
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# Optional: RapidAPI mirror of API-Football. Only needed as a fallback in
# network environments where the direct api-sports.io host is blocked.
# Get this from the "Endpoints" tab on the API-Football listing on RapidAPI
# after subscribing to the free plan.
RAPIDAPI_KEY=
RAPIDAPI_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# --- wnba/app.py admin panel (all optional; see README_WNBA.md) ---
# Password fallback for unlocking the admin panel/Bet Builder tab -- needed
# for local runs, since IP matching only works for a real deployed site.
ADMIN_PASSWORD=
# Comma-separated public IP(s) that auto-unlock the admin panel on a
# deployed site, e.g. ADMIN_ALLOWED_IPS=162.154.102.159
ADMIN_ALLOWED_IPS=
# A GitHub personal access token (repo or actions:write scope) so the admin
# panel's "Refresh data now" button can trigger the GitHub Actions workflow.
ADMIN_GITHUB_TOKEN=
