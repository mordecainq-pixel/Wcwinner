# Copy this file to .env and fill in real values. .env is gitignored.

# football-data.org — used as X-Auth-Token header
FOOTBALL_DATA_API_TOKEN=

# The Odds API — https://the-odds-api.com
ODDS_API_KEY=

# Optional fallback, only needed if we end up using API-Football instead of / alongside football-data.org
API_FOOTBALL_KEY=
